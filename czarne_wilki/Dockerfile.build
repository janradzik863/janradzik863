# ================================================================
# Dockerfile: Kompilacja APK + Desktop — Czarne Wilki Prawdy
# ================================================================
# Użycie (JEDYNE polecenie do uruchomienia):
#
#   docker build -f Dockerfile.build -t czarne-wilki-build .
#   docker run --rm -v "$(pwd)/output:/output" czarne-wilki-build
#
# Po zakończeniu gotowe pliki znajdziesz w katalogu ./output/:
#   - app-debug.apk
#   - app-release.apk
#   - czarne-wilki-linux-x64.tar.gz
# ================================================================

FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV ANDROID_HOME=/opt/android-sdk
ENV ANDROID_SDK_ROOT=/opt/android-sdk
ENV FLUTTER_HOME=/opt/flutter
ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
ENV PATH="$FLUTTER_HOME/bin:$ANDROID_HOME/cmdline-tools/latest/bin:$ANDROID_HOME/platform-tools:$JAVA_HOME/bin:$PATH"

# 1. Zależności systemowe
RUN apt-get update && apt-get install -y --no-install-recommends \
    openjdk-17-jdk-headless \
    curl git unzip xz-utils zip \
    clang cmake ninja-build pkg-config \
    libgtk-3-dev liblzma-dev libstdc++-12-dev \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# 2. Android SDK Command Line Tools
RUN mkdir -p $ANDROID_HOME/cmdline-tools && \
    curl -fsSL "https://dl.google.com/android/repository/commandlinetools-linux-11076708_latest.zip" \
      -o /tmp/cmdline-tools.zip && \
    unzip -q /tmp/cmdline-tools.zip -d /tmp/cmdline && \
    mv /tmp/cmdline/cmdline-tools $ANDROID_HOME/cmdline-tools/latest && \
    rm -rf /tmp/cmdline-tools.zip /tmp/cmdline

# 3. Android SDK (platform, build-tools)
RUN yes | sdkmanager --licenses > /dev/null 2>&1 && \
    sdkmanager \
      "platform-tools" \
      "platforms;android-35" \
      "build-tools;35.0.0" \
      "ndk;27.0.12077973"

# 4. Flutter SDK
RUN git clone --depth 1 -b stable https://github.com/flutter/flutter.git $FLUTTER_HOME && \
    flutter --version && \
    flutter config --enable-linux-desktop && \
    flutter precache --android --linux

# 5. Kopiuj projekt
WORKDIR /app
COPY . .

# 6. Zależności Dart
RUN flutter pub get

# 7. Skrypt budowania
RUN echo '#!/bin/bash' > /build.sh && \
    echo 'set -e' >> /build.sh && \
    echo 'echo "╔══════════════════════════════════════════════════════════╗"' >> /build.sh && \
    echo 'echo "║  🐺 CZARNE WILKI PRAWDY — Kompilacja od A do Z        ║"' >> /build.sh && \
    echo 'echo "╚══════════════════════════════════════════════════════════╝"' >> /build.sh && \
    echo '' >> /build.sh && \
    echo 'mkdir -p /output' >> /build.sh && \
    echo '' >> /build.sh && \
    echo 'echo "📱 [1/3] Budowanie APK (debug)..."' >> /build.sh && \
    echo 'flutter build apk --debug' >> /build.sh && \
    echo 'cp build/app/outputs/flutter-apk/app-debug.apk /output/' >> /build.sh && \
    echo '' >> /build.sh && \
    echo 'echo "📱 [2/3] Budowanie APK (release)..."' >> /build.sh && \
    echo 'flutter build apk --release' >> /build.sh && \
    echo 'cp build/app/outputs/flutter-apk/app-release.apk /output/' >> /build.sh && \
    echo '' >> /build.sh && \
    echo 'echo "🖥️  [3/3] Budowanie Desktop Linux..."' >> /build.sh && \
    echo 'flutter build linux --release' >> /build.sh && \
    echo 'cd build/linux/x64/release/bundle && tar czf /output/czarne-wilki-linux-x64.tar.gz . && cd /app' >> /build.sh && \
    echo '' >> /build.sh && \
    echo 'echo ""' >> /build.sh && \
    echo 'echo "✅ GOTOWE! Pliki do pobrania w /output/:"' >> /build.sh && \
    echo 'ls -lh /output/' >> /build.sh && \
    echo 'echo ""' >> /build.sh && \
    echo 'echo "📱 Android: /output/app-release.apk"' >> /build.sh && \
    echo 'echo "🖥️  Linux:   /output/czarne-wilki-linux-x64.tar.gz"' >> /build.sh && \
    chmod +x /build.sh

CMD ["/build.sh"]
