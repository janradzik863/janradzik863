name: Build and Release APK

# Ten workflow KOMPILUJE prawdziwy APK i PUBLIKUJE go jako plik do pobrania
# w zakładce "Releases" Twojego repozytorium.
#
# JAK URUCHOMIĆ (1 czynność, ~5 minut):
#   1. Na GitHubie otwórz repo: github.com/janradzik863/janradzik863
#   2. Add file -> Create new file -> ścieżka: .github/workflows/build-apk.yml
#   3. Wklej CAŁĄ zawartość tego pliku -> Commit changes.
#   4. Build ruszy automatycznie. Gdy skończy, APK będzie do pobrania z:
#      https://github.com/janradzik863/janradzik863/releases
#
# UWAGA: w ustawieniach repo musi być włączone:
#   Settings -> Actions -> General -> Workflow permissions
#   -> zaznacz "Read and write permissions".

on:
  push:
    branches: [ "arena/01a01b59-janradzik863", "main" ]
  workflow_dispatch:

permissions:
  contents: write   # wymagane do utworzenia Release z APK

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Set up JDK 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Set up Flutter
        uses: subosito/flutter-action@v2
        with:
          channel: stable
          cache: true

      - name: Flutter doctor
        run: flutter doctor -v

      - name: Get dependencies
        run: flutter pub get

      - name: Build universal APK (release)
        run: flutter build apk --release

      - name: Build split-per-ABI APKs (release)
        run: flutter build apk --release --split-per-abi

      - name: Upload APK artifacts
        uses: actions/upload-artifact@v4
        with:
          name: czarne-wilki-prawdy-apk
          path: build/app/outputs/flutter-apk/*.apk
          if-no-files-found: error

      - name: Publish APK to GitHub Releases
        uses: softprops/action-gh-release@v2
        with:
          tag_name: v1.0.0-${{ github.run_number }}
          name: "Czarne Wilki Prawdy — build ${{ github.run_number }}"
          files: build/app/outputs/flutter-apk/*.apk
          draft: false
